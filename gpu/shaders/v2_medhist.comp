#version 450
#extension GL_GOOGLE_include_directive : require
// V2 estimate: medhist.comp's global median seed candidate, the same value, faster (V1's pass is ~0.02 ms per level, mostly two
// threads scanning 256 bins serially). The histogram is built over the PARENT blocks, each weighted by the number of fine blocks
// that map to it (min(ix / 2, pw - 1), as medhist.comp counts them one by one), from the parent's 3x3 median taken here (fPar is
// the parent's raw search output, see v2_est.glsl). The k-th value comes from a parallel prefix sum. Writes 2 * median to
// u[medIdx..+1].
#include "common.glsl"
#include "motion_v1.glsl"
#include "v2_est.glsl"
layout(local_size_x = 256) in;
#ifdef FG_WIDE
// The *_wide build (see medhist.comp, same two passes: bins of 2^SH, SH = pc.radius, then an exact histogram of the low SH bits of the
// vectors in the four bins that hold the median's order statistics), with this shader's weights and 3x3 median.
shared uint hx[256], hy[256];
shared uint fine[4][256];
shared int tb[4];
shared uint tbase[4], tk[4];
shared float tv[4];

int wAxis(int j, int n, int np) { return j < np - 1 ? clamp(n - 2 * j, 0, 2) : max(n - 2 * j, 0); }

void main() {
    uint t = gl_LocalInvocationIndex;
    const int sh = pc.radius;
    const int mask = (1 << sh) - 1;
    hx[t] = 0u; hy[t] = 0u;
    fine[0][t] = 0u; fine[1][t] = 0u; fine[2][t] = 0u; fine[3][t] = 0u;
    barrier();
    int np = pc.pw * pc.ph;
    for (int i = int(t); i < np; i += 256) {
        int px = i % pc.pw, py = i / pc.pw;
        uint w = uint(wAxis(px, pc.bw, pc.pw) * wAxis(py, pc.bh, pc.ph));
        if (w == 0u) continue;
        ivec2 v = ivec2(roundEven(median3At(pc.fPar, ivec2(px, py), pc.pw, pc.ph)));
        atomicAdd(hx[clamp((v.x >> sh) + 128, 0, 255)], w);
        atomicAdd(hy[clamp((v.y >> sh) + 128, 0, 255)], w);
    }
    barrier();
    if (t < 4u) {   // target t: axis t / 2, order statistic k1 (t even) or k2
        int n = pc.bw * pc.bh;
        uint k = t % 2u == 0u ? uint(n - 1) / 2u : uint(n) / 2u;
        bool isX = t < 2u;
        uint acc = 0u;
        int b = 255;
        uint base = 0u;
        for (int c = 0; c < 256; c++) {
            uint h = isX ? hx[c] : hy[c];
            if (acc + h > k) { b = c; base = acc; break; }
            acc += h;
        }
        tb[t] = b; tbase[t] = base; tk[t] = k;
    }
    barrier();
    for (int i = int(t); i < np; i += 256) {
        int px = i % pc.pw, py = i / pc.pw;
        uint w = uint(wAxis(px, pc.bw, pc.pw) * wAxis(py, pc.bh, pc.ph));
        if (w == 0u) continue;
        ivec2 v = ivec2(roundEven(median3At(pc.fPar, ivec2(px, py), pc.pw, pc.ph)));
        for (int j = 0; j < 4; j++) {
            int c = j < 2 ? v.x : v.y;
            if (clamp((c >> sh) + 128, 0, 255) == tb[j]) atomicAdd(fine[j][c & mask], w);
        }
    }
    barrier();
    if (t < 4u) {
        uint acc = tbase[t];
        int f = 0;
        for (; f < mask; f++) {
            acc += fine[t][f];
            if (acc > tk[t]) break;
        }
        tv[t] = float(((tb[t] - 128) << sh) + f);
    }
    barrier();
    if (t < 2u) u[pc.medIdx + int(t)] = floatBitsToUint(2.0 * (0.5 * (tv[2u * t] + tv[2u * t + 1u])));
}
#else
layout(local_size_x = 256) in;
shared uint hx[256], hy[256];
shared float res[4];

// fine blocks (of n along an axis) whose parent index min(i / 2, np - 1) is j
int wAxis(int j, int n, int np) { return j < np - 1 ? clamp(n - 2 * j, 0, 2) : max(n - 2 * j, 0); }

void main() {
    uint t = gl_LocalInvocationIndex;
    hx[t] = 0u; hy[t] = 0u;
    barrier();
    int np = pc.pw * pc.ph;
    for (int i = int(t); i < np; i += 256) {
        int px = i % pc.pw, py = i / pc.pw;
        uint w = uint(wAxis(px, pc.bw, pc.pw) * wAxis(py, pc.bh, pc.ph));
        if (w == 0u) continue;
        ivec2 v = ivec2(roundEven(median3At(pc.fPar, ivec2(px, py), pc.pw, pc.ph)));
        atomicAdd(hx[clamp(v.x + 128, 0, 255)], w);
        atomicAdd(hy[clamp(v.y + 128, 0, 255)], w);
    }
    barrier();
    // inclusive prefix sums (Hillis-Steele), both components
    for (uint s = 1u; s < 256u; s <<= 1) {
        uint ax = t >= s ? hx[t - s] : 0u, ay = t >= s ? hy[t - s] : 0u;
        barrier();
        hx[t] += ax; hy[t] += ay;
        barrier();
    }
    // medhist.comp kth(): the first bin whose running count exceeds k (127 if none)
    int n = pc.bw * pc.bh;
    uint k1 = uint(n - 1) / 2u, k2 = uint(n) / 2u;
    if (t < 4u) res[t] = 127.0;
    barrier();
    uint ex = t > 0u ? hx[t - 1u] : 0u, ey = t > 0u ? hy[t - 1u] : 0u;
    float b = float(int(t) - 128);
    if (hx[t] > k1 && ex <= k1) res[0] = b;
    if (hx[t] > k2 && ex <= k2) res[1] = b;
    if (hy[t] > k1 && ey <= k1) res[2] = b;
    if (hy[t] > k2 && ey <= k2) res[3] = b;
    barrier();
    if (t < 2u) {
        float m = 0.5 * (t == 0u ? res[0] + res[1] : res[2] + res[3]);
        u[pc.medIdx + int(t)] = floatBitsToUint(2.0 * m);
    }
}
#endif
