#version 450
#extension GL_GOOGLE_include_directive : require
// MotionVersion::V3, build step Y1 (gpu/V3.md section 3.10): vectors in occluded strips. Dispatch ceil(fw / 16) x ceil(fh / 16) x 2 (z = direction),
// workgroup 16x16. Reads FD, the pixel's own frame's raw colour (b13 raw[0]: prev for F01, curr for F10) and MAP; writes FF[dir]. A pixel with an
// occlusion o_est < 0.2 copies FD (nearly all pixels). Otherwise: in each of the 4 axis directions walk up to R_FILL = 12 flow px to the first
// pixel with o_est < 0.1 and take its vector v_k, colour col_k and distance d_k;
//   w_k = exp(-|col(p) - col_k|_1 / 24) / (1 + d_k / 8),  v_fill = sum w_k v_k / sum w_k  (none found: FD stays),
//   FF = mix(FD, v_fill, smoothstep(0.2, 0.8, o_est)).
// o_est is the occlusion of 3.11 with the estimate's defaults and the garbage measure applied (v3OccEff: a broad inconsistent region has no
// trustworthy neighbour within reach, and is smeared by `u` instead). Soft all the way: the mix ramps with o_est, no switch.
#include "common.glsl"
#include "v3_common.glsl"
#include "v3_maps.glsl"
layout(local_size_x = 16, local_size_y = 16) in;

const int R_FILL = 12;   // flow px of the dense walk; beyond it the walk probes at growing strides up to R_FAR (tuning D5: strips of 90 flow px: a layer at 180 px per pair)
const int R_FAR = 96;
const float CONF0 = 0.75, CONF1 = 3.0;

vec2 fdAt(int dir, int pix) {
    const int i = pc.fdOff + dir * 2 * pc.fw * pc.fh + 2 * pix;
    return vec2(fl[i], fl[i + 1]);
}
float oEstAt(int dir, int pix) { return uintBitsToFloat(ax[2 * pc.fw * pc.fh + dir * pc.fw * pc.fh + pix]); }   // v3_occl's o_eff
vec3 rawAt(int dir, int pix) {   // Y, Cb, Cr (levels) of the pixel's own frame, flow resolution
    const uvec2 t = pyr[dir * pc.fw * pc.fh + pix];
    return vec3(unpackHalf2x16(t.x), unpackHalf2x16(t.y).x);
}

// (task 103) the frame-edge band. Content that leaves the view (only in this pixel's frame) or comes into it has no partner in the other frame: its matching
// cost compares against whatever looks alike (flat sky matches anywhere) and its forward-backward error is 31.9 by definition, so its vector and the
// garbage measure g of v3_occl are noise in blocks (g goes 0 / 1 block by block with the spread of the noise vectors), and the synthesis alternated
// between two wrong candidates in 16 px tiles. The band is where the pixel's own target (p + F) or the camera model's target (p + cam(p)) lies outside
// the frame; there the vector is replaced, softly, by the smooth extrapolation of the interior flow: a walk from p straight inward (away from the edge
// the target leaves through) to the first pixels whose own target stays inside and whose raw occlusion (AUX, v3_occl) is low, colour-weighted; none
// found: the camera model. g is lowered there by the replacement when the walk found agreeing vectors, so the pixel is the one-sided occluded content
// of its own frame (o stays as measured: the target is outside), drawn from the frame that shows it. (An extra hole in v3_project for a source outside
// its frame was tried and dropped: the synthetic entering-edge rows of v3test got worse, the real edge bands no better.)
const int EB_STEP = 4, EB_N = 48;   // walk: every 4 flow px, up to 192 flow px (384 px at flowScale 2)
float outDist(vec2 t) { return max(max(-t.x, t.x - float(pc.fw - 1)), max(-t.y, t.y - float(pc.fh - 1))); }
void edgeBand(int dir, ivec2 p, int pix, inout vec2 r) {
    const vec2 pf = vec2(p);
    vec2 cm = camModel(pf);
    if (dir == 1) cm = -camModel(pf - cm);   // F10: the content at curr position p came from p - d(p)
    const vec2 v0 = fdAt(dir, pix);
    const vec2 tOwn = pf + v0, tCam = pf + cm;
    const float oOwn = outDist(tOwn), oCam = outDist(tCam);
    const uint w0 = ax[mapOff(dir) + pix];
    const V3Map mp = v3MapUnpack(w0);
    const float oRaw = v3Occ(mp.e, length(v0), 1.0);
    // the exit side of the target that is farther outside; the walk goes the other way. A pixel whose own (unverifiable) vector leaves the frame counts only
    // within reach of the edge (a garbage vector far inside is the ordinary fill's business): up to twice the camera motion plus a margin
    const vec2 tt = oOwn > oCam ? tOwn : tCam;
    const vec4 sides = vec4(tt.x - float(pc.fw - 1), -tt.x, tt.y - float(pc.fh - 1), -tt.y);
    int side = 0;
    for (int k = 1; k < 4; k++) if (sides[k] > sides[side]) side = k;
    const ivec2 stp = side == 0 ? ivec2(-1, 0) : side == 1 ? ivec2(1, 0) : side == 2 ? ivec2(0, -1) : ivec2(0, 1);
    const float dEdge = side == 0 ? float(pc.fw - 1 - p.x) : side == 1 ? float(p.x) : side == 2 ? float(pc.fh - 1 - p.y) : float(p.y);
    const float lc = length(cm);
    const float wOwn = smoothstep(-4.0, 4.0, oOwn) * (1.0 - smoothstep(1.5 * lc + 16.0, 2.0 * lc + 32.0, dEdge));
    // the camera's band counts where the two frames differ at p (a static overlay at the edge, the HUD, looks the same in both and keeps its own vector;
    // flat content looks the same under any vector, so nothing is lost there)
    const vec3 z3 = abs(rawAt(0, pix) - rawAt(1, pix));
    const float wb = max(wOwn, smoothstep(-4.0, 4.0, oCam) * smoothstep(4.0, 12.0, max(z3.x, max(z3.y, z3.z)))) * oRaw;
    if (wb <= 0.0) return;
    const vec3 col = rawAt(dir, pix);
    vec2 acc = vec2(0.0);
    float ws = 0.0, acc2 = 0.0, nh = 0.0;
    for (int i = 1; i <= EB_N && nh < 3.0; i++) {
        const ivec2 q = p + stp * (i * EB_STEP);
        if (q.x < 0 || q.y < 0 || q.x >= pc.fw || q.y >= pc.fh) break;
        const int qi = q.y * pc.fw + q.x;
        const vec2 vq = fdAt(dir, qi);
        if (outDist(vec2(q) + vq) > -2.0 || oEstAt(dir, qi) > 0.3) {   // (v3_occl's raw o: the MAP words are being rewritten by this pass)
            if (nh > 0.0) break;   // the hits are consecutive: the first consistent stretch inward
            continue;
        }
        const float w = exp(-dot(abs(col - rawAt(dir, qi)), vec3(1.0)) * (1.0 / 30.0));
        if (w < 0.3) {   // another surface (a near post in front of the leaving sky): not this pixel's motion
            if (nh > 0.0) break;
            continue;
        }
        acc += w * vq;
        acc2 += w * dot(vq, vq);
        ws += w;
        nh += 1.0;
    }
    vec2 ve = cm;
    float conf = 0.0;
    if (ws > 0.0) {
        ve = acc / ws;
        const float spread = sqrt(max(acc2 / ws - dot(ve, ve), 0.0));
        conf = 1.0 - smoothstep(CONF0, CONF1, spread);
    }
    r = mix(r, ve, wb);
    const uint g8 = uint(float(w0 >> 24) * (1.0 - wb * conf) + 0.5);
    ax[mapOff(dir) + pix] = (w0 & 0x00ffffffu) | (g8 << 24);
}

void main() {
    const int dir = int(gl_GlobalInvocationID.z);
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.fw || p.y >= pc.fh) return;
    const int N = pc.fw * pc.fh;
    const int pix = p.y * pc.fw + p.x;
    const float o = oEstAt(dir, pix);
    vec2 r = vec2(0.0);
    bool copy = true;
    if (o >= 0.2 && (pc.mode & 4) == 0) {   // (mode bit 2 = inject: the flows are the injected exact ones, there is nothing to fill)
        const vec3 col = rawAt(dir, pix);
        vec2 acc = vec2(0.0);
        float ws = 0.0, acc2 = 0.0, dmin = 1e9, nh = 0.0;
        // the four walks advance together (independent loads overlap); a walk that found its pixel, or left the frame, stops
        ivec2 hit[4] = ivec2[4](ivec2(-1), ivec2(-1), ivec2(-1), ivec2(-1));
        int dist[4] = int[4](0, 0, 0, 0);
        const ivec2 dirs[4] = ivec2[4](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));
        const bool farOk = (ax[mapOff(dir) + pix] >> 24) >= 0u;   // (the far probes in every flagged pixel; gating them by g cost bf400 0.25 dB): elsewhere a far neighbour's vector is another surface's
        for (int i = 1; i <= R_FILL + (farOk ? 6 : 0); i++) {
            const int s = i <= R_FILL ? i : R_FILL + (i - R_FILL) * (i - R_FILL) * 2 + (i - R_FILL) * 2;   // 12 dense steps, then 16, 28, 42, 60, 80, 102 (clamped to R_FAR)
            if (s > R_FAR && i > R_FILL + 1) break;
            for (int k = 0; k < 4; k++) {
                if (dist[k] != 0) continue;
                ivec2 q = p + dirs[k] * min(s, R_FAR);
                if (q.x < 0 || q.y < 0 || q.x >= pc.fw || q.y >= pc.fh) { dist[k] = -1; continue; }
                if (s > R_FILL) q = min(((q >> 3) << 3) + 4, ivec2(pc.fw - 1, pc.fh - 1));   // far probes sit on a coarse grid: neighbouring pixels probe the same pixels
                if (oEstAt(dir, q.y * pc.fw + q.x) < 0.1) { dist[k] = max(abs(q.x - p.x), abs(q.y - p.y)); hit[k] = q; }
            }
            if (all(notEqual(ivec4(dist[0], dist[1], dist[2], dist[3]), ivec4(0)))) break;
        }
        for (int k = 0; k < 4; k++) {
            if (dist[k] <= 0) continue;
            const int qi = hit[k].y * pc.fw + hit[k].x;
            const float w = exp(-dot(abs(col - rawAt(dir, qi)), vec3(1.0)) * (dist[k] > R_FILL ? (1.0 / 30.0) : (1.0 / 24.0))) / (1.0 + float(dist[k]) * 0.125) / (1.0 + float(dist[k]) * 0.125);   // (tuning D5: squared, a far neighbour counts for little where a near one exists)
            const vec2 fv = fdAt(dir, qi);
            acc += w * fv;
            acc2 += w * dot(fv, fv);
            dmin = min(dmin, float(dist[k]));
            ws += w;
            nh += 1.0;
        }
        if (ws > 0.0) {
            const float wf = smoothstep(0.2, 0.8, o);
            r = mix(fdAt(dir, pix), acc / ws, wf);
            copy = false;
            // (tuning D5) a pixel that now carries a trustworthy neighbour's vector is no longer a garbage pixel: its garbage measure g falls with the fill, so that the
            // synth sees its occlusion (one-sided taps from the frame that shows it) instead of smearing it
            const uint w0 = ax[mapOff(dir) + pix];
            const vec2 mu = acc / ws;
            const float spread = sqrt(max(acc2 / ws - dot(mu, mu), 0.0));   // how much the probes' vectors disagree (flow px)
            const float conf = (1.0 - smoothstep(CONF0, CONF1, spread)) * (1.0 - smoothstep(48.0, 96.0, dmin)) * min(nh - 1.0, 1.0);
            const uint g8 = uint(float(w0 >> 24) * (1.0 - wf * conf) + 0.5);
            ax[mapOff(dir) + pix] = (w0 & 0x00ffffffu) | (g8 << 24);
        }
    }
    if (copy) r = fdAt(dir, pix);
    if ((pc.mode & 4) == 0) edgeBand(dir, p, pix, r);
    const int ff = pc.fdOff + 4 * N + dir * 2 * N + 2 * pix;   // FF[2] follows FD[2] (2N floats per direction)
    fl[ff] = r.x;
    fl[ff + 1] = r.y;
}
